#. settings-schema.json->layout->general
msgid "General"
msgstr "Geral"

#. settings-schema.json->layout->appearance
msgid "Appearance"
msgstr "Aparência"

#. settings-schema.json->layout->shortcuts
msgid "Shortcuts"
msgstr "Atalhos"

#. settings-schema.json->layout->history
msgid "History"
msgstr "Histórico"

#. settings-schema.json->layout->behavior
msgid "Behavior"
msgstr "Comportamento"

#. settings-schema.json->layout->privacy
msgid "Privacy"
msgstr "Privacidade"

#. settings-schema.json->layout->look
msgid "Clipboard bar"
msgstr "Barra"

#. settings-schema.json->layout->keys
msgid "Keyboard shortcuts"
msgstr "Atalhos de teclado"

#. settings-schema.json->history-length->description
msgid "Items to keep"
msgstr "Itens guardados"

#. settings-schema.json->history-length->tooltip
msgid "Pinned and tagged items are kept on top of this limit."
msgstr "Itens fixados e com etiqueta são guardados além desse limite."

#. settings-schema.json->history-length->units
msgid "items"
msgstr "itens"

#. settings-schema.json->history-minutes->description
msgid "Forget items older than"
msgstr "Esquecer itens com mais de"

#. settings-schema.json->history-minutes->tooltip
msgid "0 keeps items until the limit above is reached. Pinned and tagged items never expire."
msgstr "0 guarda os itens até atingir o limite acima. Itens fixados e com etiqueta nunca expiram."

#. settings-schema.json->history-minutes->units
msgid "minutes"
msgstr "minutos"

#. settings-schema.json->on-new-session->description
msgid "When you log in again"
msgstr "Ao entrar de novo na sessão"

#. settings-schema.json->on-new-session->options
msgid "Keep everything"
msgstr "Manter tudo"

#. settings-schema.json->on-new-session->options
msgid "Keep only pinned and tagged items"
msgstr "Manter só os fixados e com etiqueta"

#. settings-schema.json->on-new-session->options
msgid "Start with an empty history"
msgstr "Começar com o histórico vazio"

#. settings-schema.json->protect-pinned->description
msgid "Protect pinned items"
msgstr "Proteger itens fixados"

#. settings-schema.json->protect-pinned->tooltip
msgid "Pinned items can only be deleted with Shift+Delete."
msgstr "Itens fixados só são apagados com Shift+Delete."

#. settings-schema.json->protect-tagged->description
msgid "Protect tagged items"
msgstr "Proteger itens com etiqueta"

#. settings-schema.json->protect-tagged->tooltip
msgid "Tagged items can only be deleted with Shift+Delete."
msgstr "Itens com etiqueta só são apagados com Shift+Delete."

#. settings-schema.json->paste-on-select->description
msgid "Paste when an item is chosen"
msgstr "Colar ao escolher um item"

#. settings-schema.json->paste-on-select->tooltip
msgid "On: Enter and click paste into the focused app (Shift copies only). Off: they only copy (Shift pastes)."
msgstr "Ligado: Enter e clique colam no app em foco (com Shift, só copiam). Desligado: só copiam (com Shift, colam)."

#. settings-schema.json->copy-sound->description
msgid "Play a sound when something is copied"
msgstr "Tocar um som ao copiar"

#. settings-schema.json->show-tray-icon->description
msgid "Show the tray icon"
msgstr "Mostrar o ícone na bandeja"

#. settings-schema.json->incognito->tooltip
msgid "While on, nothing new is saved to the history."
msgstr "Enquanto estiver ligado, nada novo é salvo no histórico."

#. settings-schema.json->excluded-apps->description
msgid "Ignore copies from these apps"
msgstr "Ignorar cópias destes apps"

#. settings-schema.json->excluded-apps->tooltip
msgid "Window classes separated by commas, for example: keepassxc, bitwarden"
msgstr "Classes de janela separadas por vírgula, por exemplo: keepassxc, bitwarden"

#. settings-schema.json->position->description
msgid "Position on screen"
msgstr "Posição na tela"

#. settings-schema.json->position->options
msgid "Bottom"
msgstr "Embaixo"

#. settings-schema.json->position->options
msgid "Top"
msgstr "Em cima"

#. settings-schema.json->item-width->description
msgid "Card width"
msgstr "Largura dos cartões"

#. settings-schema.json->item-width->units
msgid "pixels"
msgstr "pixels"

#. settings-schema.json->item-height->description
msgid "Card height"
msgstr "Altura dos cartões"

#. settings-schema.json->image-fit->description
msgid "Images"
msgstr "Imagens"

#. settings-schema.json->image-fit->options
msgid "Fill the card (crop)"
msgstr "Preencher o cartão (cortar)"

#. settings-schema.json->image-fit->options
msgid "Show the whole image"
msgstr "Mostrar a imagem inteira"

#. settings-schema.json->shortcut-open->description
msgid "Open the clipboard history"
msgstr "Abrir o histórico"

#. settings-schema.json->shortcut-incognito->description
msgid "Toggle incognito mode"
msgstr "Ligar/desligar o modo incógnito"

#. metadata.json->description
msgid "Clipboard history for Cinnamon, modelled on Copyous: Super+V opens a bar with your recent copies (text, code, links, images, GIFs, files, colors); pick one to paste it."
msgstr "Histórico da área de transferência para o Cinnamon, inspirado no Copyous: Super+V abre uma barra com suas cópias recentes (texto, código, links, imagens, GIFs, arquivos, cores); escolha uma para colar."
